{
    "name": "liberusoftware/ecommerce-returns-livewire",
    "description": "Livewire 4 storefront returns for liberusoftware/ecommerce-returns: a shopper's own returns addressed by the RMA number, and the one shopper-facing surface in this fleet that causes a domain write — a return request whose eligibility is read server-side and whose free text can never travel back out.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-returns"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "liberusoftware/ecommerce-returns": "^0.1"
    },
    "require-dev": {
        "liberusoftware/ecommerce-returns": "^0.1",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Returns\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Returns\\Livewire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-returns-livewire"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
